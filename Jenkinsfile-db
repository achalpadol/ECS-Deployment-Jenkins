pipeline {
    agent any
    environment {
        AWS_REGION = 'ap-south-1'
        AWS_ACCOUNT_ID = '552940445807'
        ECR_REGISTRY = "${AWS_ACCOUNT_ID}.dkr.ecr.${AWS_REGION}.amazonaws.com"
        ECR_REGISTRY_URL = "https://${AWS_ACCOUNT_ID}.dkr.ecr.${AWS_REGION}.amazonaws.com"
        IMAGE_TO_PUSH = "${ECR_REGISTRY}/${DATABASE_IMAGE}:${GIT_COMMIT}"
        // =========================================================
        // Database images
        // =========================================================

        DATABASE_IMAGE_DEV  = 'app-2-db-dev'
        DATABASE_IMAGE_QA   = 'app-2-db-qa'
        DATABASE_IMAGE_UAT  = 'app-2-db-uat'
        DATABASE_IMAGE_PROD = 'app-2-db-prod'

        // AWS credentials
        AWS_CREDENTIALS = 'aws-credentials'

        // Database Docker build context
        BUILD_CONTEXT = './nginx-flask-mysql/db'
        DATABASE_DOCKERFILE = './nginx-flask-mysql/db/Dockerfile'
    }

    parameters {

        choice(
            name: 'Environment',
            choices: ['dev', 'qa', 'uat', 'prod'],
            description: 'Select the deployment environment'
        )
    }

    stages {

        // =========================================================
        // DEV
        // =========================================================

        stage('Dev - Build & Push Database') {

            when {
                expression {
                    params.Environment == 'dev'
                }
            }

            steps {

                script {

                    buildAndPush(
                        "${env.DATABASE_IMAGE_DEV}",
                        "${env.BUILD_CONTEXT}"
                    )
                }
            }
        }

        // =========================================================
        // QA
        // =========================================================

        stage('Promote Database Dev to QA') {

            when {
                expression {
                    params.Environment == 'qa'
                }
            }

            steps {

                script {

                    promoteImage(
                        "${env.DATABASE_IMAGE_DEV}",
                        "${env.DATABASE_IMAGE_QA}"
                    )
                }
            }
        }

        // =========================================================
        // UAT
        // =========================================================

        stage('Promote Database QA to UAT') {

            when {
                expression {
                    params.Environment == 'uat'
                }
            }

            steps {

                script {

                    promoteImage(
                        "${env.DATABASE_IMAGE_QA}",
                        "${env.DATABASE_IMAGE_UAT}"
                    )
                }
            }
        }

        // =========================================================
        // PROD APPROVAL
        // =========================================================

        stage('Approval for Database Prod Deployment') {

            when {
                expression {
                    params.Environment == 'prod'
                }
            }

            steps {

                input(
                    message: 'Promote Database UAT image to PROD?',
                    ok: 'Proceed'
                )
            }
        }

        // =========================================================
        // PROD
        // =========================================================

        stage('Promote Database UAT to PROD') {

            when {
                expression {
                    params.Environment == 'prod'
                }
            }

            steps {

                script {

                    promoteImage(
                        "${env.DATABASE_IMAGE_UAT}",
                        "${env.DATABASE_IMAGE_PROD}"
                    )
                }
            }
        }
    }

    // =============================================================
    // POST
    // =============================================================

    post {

        always {

            deleteDir()
        }
    }
}

// =================================================================
// FUNCTION 1 - BUILD AND PUSH DATABASE IMAGE
// =================================================================

def buildAndPush(String DATABASE_IMAGE, String BUILD_CONTEXT) {

    def imageName =
        "${env.ECR_REGISTRY}/${DATABASE_IMAGE}:${env.GIT_COMMIT}"

    docker.build(
        imageName,
        "-f ${env.DATABASE_DOCKERFILE} ${BUILD_CONTEXT}"
    )
    sh '''
        set -e

        echo "Logging into Amazon ECR..."

        aws ecr get-login-password --region "$AWS_REGION" |
        docker login \
            --username AWS \
            --password-stdin "$ECR_REGISTRY"

        echo "Pushing image..."

        docker push "$IMAGE_TO_PUSH"
    '''
}

// =================================================================
// FUNCTION 2 - PROMOTE DATABASE IMAGE
// =================================================================

def promoteImage(String sourceImage, String targetImage) {

    def source =
        "${env.ECR_REGISTRY}/${sourceImage}:${env.GIT_COMMIT}"

    def target =
        "${env.ECR_REGISTRY}/${targetImage}:${env.GIT_COMMIT}"

    sh """
        set -e

        echo "Logging into ECR..."

        aws ecr get-login-password --region ${env.AWS_REGION} |
        docker login --username AWS --password-stdin ${env.ECR_REGISTRY}

        echo "Pulling ${source}..."

        docker pull ${source}

        echo "Tagging image..."

        docker tag ${source} ${target}

        echo "Pushing ${target}..."

        docker push ${target}
    """
}