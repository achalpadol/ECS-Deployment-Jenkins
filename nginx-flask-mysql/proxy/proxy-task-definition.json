{
  "family": "frontend-task-definition",
  "networkMode": "awsvpc",
  "requiresCompatibilities": [
    "FARGATE"
  ],
  "cpu": "256",
  "memory": "512",
  "executionRoleArn": "arn:aws:iam::552940445807:role/ecsTaskExecutionRole",
  "containerDefinitions": [
    {
      "name": "proxy",
      "image": "552940445807.dkr.ecr.ap-south-1.amazonaws.com/app-2-proxy-${ENV}:${COMMIT_ID}",
      "essential": true,
      "portMappings": [
        {
          "containerPort": 80,
          "protocol": "tcp"
        }
      ]
    }
  ]
}